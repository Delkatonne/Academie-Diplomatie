SECRET_KEY=replace-with-a-random-secret
DB_HOST=localhost
DB_PORT=5432
DB_NAME=academie_diplomatie
DB_USER=academie_app
DB_PASSWORD=replace-with-your-local-database-password
# 1 = mode développement (rechargement auto, pages d'erreur détaillées). Mettre 0 en production.
FLASK_DEBUG=1
# Mettre 1 en production (site en HTTPS) pour que les cookies ne circulent qu'en HTTPS.
SESSION_COOKIE_SECURE=0
